digraph G {
    subgraph cluster_sources {
        label = "Sources";

        tableur [style=filled]
        couleurs [style=filled]
        drive_SVG [style=filled]
        osm [style=filled]
        sit [style=filled]
        opendata [style=filled]
    }

    subgraph cluster_ontology {
        label = "Ontology Builder";

        tableur -> ontology;
        couleurs -> ontology;
    }

    subgraph cluster_data {
        label = "OMT Builder";

        ontology -> class_sql;
        ontology -> poi_X_yaml;
        class_sql -> OpenMapTiles;
        poi_X_yaml -> OpenMapTiles;
        osm -> OpenMapTiles;

        OpenMapTiles [shape=box]
    }

    subgraph cluster_style {
        label = "Styles Builder";

        drive_SVG -> flat_icon;

        ontology -> flat_icon [label=manuel];

        flat_icon -> sprites_X;
        flat_icon -> missing_icons;

        flat_icon [shape=box]
        missing_icons [style=filled,fillcolor=cyan]
        couleurs [style=filled]
    }

    subgraph cluster_tile_serveur {
        label = "Tile Serveur";

        style_X_json -> tileserver;
        sprites_X -> tileserver;
        OpenMapTiles -> tileserver [label=MBTiles];

        tileserver [shape=box]
    }

    subgraph cluster_clearance {
        label = "Clearance";

        osm -> clearance [label="Extract/Diff"];
    }

    subgraph cluster_datasources {
        label = "Datasources";

        opendata -> datasources;
        sit -> datasources;
        clearance -> datasources[label=Overpass];
        ontology -> datasources;
        datasources -> clearance [label=Configuration];
    }

    subgraph cluster_wp_elasa {
        label = "WP/Elasa";

        datasources -> postgres;
        postgres -> API;
    }


    subgraph cluster_merge_v_mux {
        label = "Merge v_mux";

        tileserver -> merge_v_mux [label=styles];
        tileserver -> merge_v_mux [label=tiles];
        API -> merge_v_mux [label="poi/MBTiles"];
        merge_v_mux -> merge_v_mux_cache;
    }

    subgraph cluster_viso_server {
        label = "Vido Serveur";

        API -> vido [label=settings];
        API -> vido [label=menu];

        vido -> vido_cache;
    }

    subgraph cluster_elasa_search {
        label = "Elasa Search";

        API -> search [label=menu];
        API -> search [label=poi];
    }

    subgraph cluster_elasa_print {
        label = "Elasa Print";

        API -> print [label=poi];
    }

    subgraph cluster_web {
        label = "Web";

        merge_v_mux_cache -> web [label=styles];
        merge_v_mux_cache -> web [label=tiles];
        tileserver -> web [label=sprites];

        vido_cache -> web;
        API -> web [label=poi];
        search -> web;
        print -> web [label=pdf];

        web [style=filled,fillcolor=cyan]
    }
}
